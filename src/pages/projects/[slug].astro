---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProjectsCollection } from '../../lib/models';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const projectsCollection = await getProjectsCollection();
const project = await projectsCollection.findOne({ slug, published: true }) as any;
if (!project) return Astro.redirect('/');

const siteUrl = (Astro.site?.href || `${Astro.url.origin}`).replace(/\/$/, '');
const ogImage = project.coverImage || '/resource/emojis.com panda-bear-full-body-scratching.png';
const hasCover = !!(project.coverImage && project.coverImage.trim());

const projectKeywords = [
  ...(project.tags || []),
  project.category || '',
  'S. M. Ahad Ali Chowdhury',
  'software engineer Bangladesh',
].filter(Boolean).join(', ');
---

<BaseLayout
  title={`${project.title} - S. M. Ahad Ali Chowdhury`}
  description={project.description}
  ogImage={ogImage}
  ogType="article"
  canonicalUrl={`/projects/${project.slug}`}
  keywords={projectKeywords}
>
  <!-- Header inside normal container -->
  <div class="container" style="padding-bottom: 0;">
    <Header />
  </div>

  <!-- Full-width cover image banner (OUTSIDE container, only when coverImage set) -->
  {hasCover && (
    <div
      class="pd-hero-banner"
      style={`background-image: url('${project.coverImage}')`}
    >
      <div class="pd-hero-banner-overlay">
        <div class="pd-hero-content-inner">
          {project.tags && project.tags.length > 0 && (
            <div class="pd-tags">
              {project.tags.map((tag: string) => (
                <span class="pd-tag">{tag}</span>
              ))}
            </div>
          )}
          <h1 class="pd-title">{project.title}</h1>
          <p class="pd-summary">{project.description}</p>
          <div class="pd-actions">
            {project.githubLink && (
              <a href={project.githubLink} target="_blank" rel="noopener noreferrer" class="pd-btn pd-btn-ghost">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
            )}
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="pd-btn pd-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Live Demo
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Rest of content in normal container -->
  <div class="container">

    <!-- When NO cover image: show title/tags/buttons here instead -->
    {!hasCover && (
      <div class="pd-no-cover-header">
        {project.tags && project.tags.length > 0 && (
          <div class="pd-tags" style="margin-bottom:16px;">
            {project.tags.map((tag: string) => (
              <span class="pd-tag">{tag}</span>
            ))}
          </div>
        )}
        <h1 style="font-size:36px;font-weight:700;margin-bottom:14px;letter-spacing:-0.5px;">{project.title}</h1>
        <p style="font-size:16px;line-height:1.8;color:var(--text-secondary);margin-bottom:24px;max-width:680px;">{project.description}</p>
        <div class="pd-actions" style="margin-bottom:40px;">
          {project.githubLink && (
            <a href={project.githubLink} target="_blank" rel="noopener noreferrer" class="pd-btn pd-btn-outline-normal">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          )}
          {project.liveUrl && (
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="pd-btn pd-btn-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              Live Demo
            </a>
          )}
        </div>
      </div>
    )}

    <!-- Meta Info Bar -->
    {(project.client || project.projectDate || project.duration || project.category) && (
      <div class="pd-meta-bar">
        {project.client && (
          <div class="pd-meta-item">
            <span class="pd-meta-icon">👤</span>
            <div>
              <div class="pd-meta-label">Client</div>
              <div class="pd-meta-value">{project.client}</div>
            </div>
          </div>
        )}
        {project.projectDate && (
          <div class="pd-meta-item">
            <span class="pd-meta-icon">📅</span>
            <div>
              <div class="pd-meta-label">Date</div>
              <div class="pd-meta-value">{project.projectDate}</div>
            </div>
          </div>
        )}
        {project.duration && (
          <div class="pd-meta-item">
            <span class="pd-meta-icon">⏱️</span>
            <div>
              <div class="pd-meta-label">Duration</div>
              <div class="pd-meta-value">{project.duration}</div>
            </div>
          </div>
        )}
        {project.category && (
          <div class="pd-meta-item">
            <span class="pd-meta-icon">🗂️</span>
            <div>
              <div class="pd-meta-label">Category</div>
              <div class="pd-meta-value">{project.category}</div>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Challenge & Solution -->
    {(project.challenge || project.solution) && (
      <div class="pd-two-col">
        {project.challenge && (
          <div class="pd-section">
            <h2>The Challenge</h2>
            <p>{project.challenge}</p>
          </div>
        )}
        {project.solution && (
          <div class="pd-section">
            <h2>Our Solution</h2>
            <p>{project.solution}</p>
          </div>
        )}
      </div>
    )}

    <!-- Gallery -->
    {project.gallery && project.gallery.length > 0 && (
      <div class="pd-gallery-section">
        <h2>Gallery</h2>
        <div class="pd-gallery">
          {project.gallery.map((img: string, i: number) => (
            <div class="pd-gallery-item">
              <img src={img} alt={`${project.title} screenshot ${i + 1}`} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Results -->
    {project.results && project.results.length > 0 && (
      <div class="pd-results-section">
        <h2>Results</h2>
        <div class="pd-results-grid">
          {project.results.map((result: string) => (
            <div class="pd-result-item">
              <span class="pd-result-icon">✦</span>
              <span>{result}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Testimonial -->
    {project.testimonialText && (
      <div class="pd-testimonial">
        <div class="pd-testimonial-quote">❝</div>
        <blockquote>{project.testimonialText}</blockquote>
        {project.testimonialAuthor && (
          <div class="pd-testimonial-author">
            <strong>{project.testimonialAuthor}</strong>
            {project.testimonialRole && (
              <span class="pd-testimonial-role">{project.testimonialRole}</span>
            )}
          </div>
        )}
      </div>
    )}

    <div class="post-footer" style="margin-top: 60px;">
      <a href="/" class="back-link">← Back to projects</a>
    </div>

    <Footer />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": project.title,
    "description": project.description,
    "url": `${siteUrl}/projects/${project.slug}`,
    "image": project.coverImage
      ? (project.coverImage.startsWith('http') ? project.coverImage : `${siteUrl}${project.coverImage}`)
      : undefined,
    "applicationCategory": project.category || "WebApplication",
    "codeRepository": project.githubLink,
    "author": {
      "@type": "Person",
      "name": "S. M. Ahad Ali Chowdhury",
      "url": siteUrl
    },
    "keywords": project.tags ? project.tags.join(", ") : "software, backend"
  })} />
</BaseLayout>
