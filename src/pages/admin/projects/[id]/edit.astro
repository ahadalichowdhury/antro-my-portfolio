---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { requireAuth } from '../../../../lib/session';
import { getProjectsCollection } from '../../../../lib/models';
import { ObjectId } from 'mongodb';

const session = await requireAuth(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/login');
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/projects');

const projectsCollection = await getProjectsCollection();
const project = await projectsCollection.findOne({ _id: new ObjectId(id) }) as any;
if (!project) return Astro.redirect('/admin/projects');

const inputStyle = `width:100%;padding:12px;border:1px solid var(--border-color);border-radius:6px;font-family:var(--font-family);background-color:var(--bg-color);color:var(--text-color);font-size:15px;`;
const labelStyle = `display:block;margin-bottom:8px;font-weight:600;font-size:14px;`;
const sectionStyle = `margin-bottom:36px;padding-bottom:36px;border-bottom:1px solid var(--border-color);`;
const sectionTitleStyle = `font-size:18px;font-weight:700;margin-bottom:20px;color:var(--accent-color);`;

const galleryValue = (project.gallery || []).join('\n');
const resultsValue = (project.results || []).join('\n');
---

<BaseLayout title="Edit Project - Admin">
  <div class="container" style="max-width:860px;">
    <h1 style="margin-bottom:8px;">Edit Project</h1>
    <p style="color:var(--text-secondary);margin-bottom:40px;">Update the project details below.</p>

    <form method="POST" action={`/admin/projects/${id}/edit-api`} id="project-form">

      <!-- BASICS -->
      <div style={sectionStyle}>
        <div style={sectionTitleStyle}>📋 Basic Info</div>
        <div style="margin-bottom:20px;">
          <label for="title" style={labelStyle}>Title <span style="color:red">*</span></label>
          <input type="text" id="title" name="title" required value={project.title} style={inputStyle} />
        </div>
        <div style="margin-bottom:20px;">
          <label for="slug" style={labelStyle}>Slug <span style="color:red">*</span></label>
          <input type="text" id="slug" name="slug" required value={project.slug || ''} style={inputStyle} />
          <small style="color:var(--text-tertiary);font-size:13px;">⚠️ Changing the slug will break existing links to this project.</small>
        </div>
        <div style="margin-bottom:20px;">
          <label for="description" style={labelStyle}>Short Description <span style="color:red">*</span></label>
          <textarea id="description" name="description" required rows="3" style={inputStyle}>{project.description}</textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
          <div>
            <label for="githubLink" style={labelStyle}>GitHub Link <span style="color:red">*</span></label>
            <input type="url" id="githubLink" name="githubLink" required value={project.githubLink} style={inputStyle} />
          </div>
          <div>
            <label for="liveUrl" style={labelStyle}>Live URL</label>
            <input type="url" id="liveUrl" name="liveUrl" value={project.liveUrl || ''} style={inputStyle} />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
          <div>
            <label for="coverImage" style={labelStyle}>Cover Image URL</label>
            <input type="url" id="coverImage" name="coverImage" value={project.coverImage || ''} style={inputStyle} />
          </div>
          <div>
            <label for="tags" style={labelStyle}>Tags (comma-separated)</label>
            <input type="text" id="tags" name="tags" value={(project.tags || []).join(', ')} placeholder="Go, Docker, AWS" style={inputStyle} />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:80px 1fr;gap:16px;align-items:end;">
          <div>
            <label for="order" style={labelStyle}>Order</label>
            <input type="number" id="order" name="order" required min="1" value={project.order} style={inputStyle} />
          </div>
          <div style="padding-bottom:2px;">
            <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:15px;">
              <input type="checkbox" name="published" id="published" value="true" checked={project.published} style="width:18px;height:18px;cursor:pointer;" />
              <span>Published</span>
            </label>
          </div>
        </div>
      </div>

      <!-- META INFO -->
      <div style={sectionStyle}>
        <div style={sectionTitleStyle}>🗂️ Project Meta</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div>
            <label for="client" style={labelStyle}>Client / Owner</label>
            <input type="text" id="client" name="client" value={project.client || ''} placeholder="e.g. Personal Project" style={inputStyle} />
          </div>
          <div>
            <label for="projectDate" style={labelStyle}>Date</label>
            <input type="text" id="projectDate" name="projectDate" value={project.projectDate || ''} placeholder="e.g. 2024–2025" style={inputStyle} />
          </div>
          <div>
            <label for="duration" style={labelStyle}>Duration</label>
            <input type="text" id="duration" name="duration" value={project.duration || ''} placeholder="e.g. 6 months" style={inputStyle} />
          </div>
          <div>
            <label for="category" style={labelStyle}>Category</label>
            <input type="text" id="category" name="category" value={project.category || ''} placeholder="e.g. Backend / DevOps" style={inputStyle} />
          </div>
        </div>
      </div>

      <!-- CHALLENGE & SOLUTION -->
      <div style={sectionStyle}>
        <div style={sectionTitleStyle}>💡 Challenge & Solution</div>
        <div style="margin-bottom:20px;">
          <label for="challenge" style={labelStyle}>The Challenge</label>
          <textarea id="challenge" name="challenge" rows="5" style={inputStyle}>{project.challenge || ''}</textarea>
        </div>
        <div>
          <label for="solution" style={labelStyle}>Our Solution</label>
          <textarea id="solution" name="solution" rows="5" style={inputStyle}>{project.solution || ''}</textarea>
        </div>
      </div>

      <!-- GALLERY -->
      <div style={sectionStyle}>
        <div style={sectionTitleStyle}>🖼️ Gallery Images</div>
        <p style="color:var(--text-secondary);font-size:14px;margin-bottom:16px;">One image URL per line.</p>
        <textarea id="gallery" name="gallery" rows="5" placeholder="https://example.com/image1.png" style={inputStyle}>{galleryValue}</textarea>
      </div>

      <!-- RESULTS -->
      <div style={sectionStyle}>
        <div style={sectionTitleStyle}>📊 Results</div>
        <p style="color:var(--text-secondary);font-size:14px;margin-bottom:16px;">One result per line.</p>
        <textarea id="results" name="results" rows="5" style={inputStyle}>{resultsValue}</textarea>
      </div>

      <!-- TESTIMONIAL -->
      <div style={sectionStyle}>
        <div style={sectionTitleStyle}>💬 Testimonial</div>
        <div style="margin-bottom:20px;">
          <label for="testimonialText" style={labelStyle}>Quote</label>
          <textarea id="testimonialText" name="testimonialText" rows="3" style={inputStyle}>{project.testimonialText || ''}</textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div>
            <label for="testimonialAuthor" style={labelStyle}>Author Name</label>
            <input type="text" id="testimonialAuthor" name="testimonialAuthor" value={project.testimonialAuthor || ''} style={inputStyle} />
          </div>
          <div>
            <label for="testimonialRole" style={labelStyle}>Author Role</label>
            <input type="text" id="testimonialRole" name="testimonialRole" value={project.testimonialRole || ''} style={inputStyle} />
          </div>
        </div>
      </div>

      <div style="display:flex;gap:12px;">
        <button type="submit" style="padding:14px 32px;background-color:var(--accent-color);color:white;border:none;border-radius:8px;cursor:pointer;font-size:16px;font-weight:600;">
          Update Project
        </button>
        <a href="/admin/projects" style="padding:14px 24px;background-color:var(--border-color);color:var(--text-color);text-decoration:none;border-radius:8px;font-size:16px;display:inline-block;">
          Cancel
        </a>
        <a href={`/projects/${project.slug || ''}`} target="_blank" style="padding:14px 24px;border:1px solid var(--border-color);color:var(--text-color);text-decoration:none;border-radius:8px;font-size:16px;display:inline-block;margin-left:auto;">
          View Live →
        </a>
      </div>
    </form>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('project-form') as HTMLFormElement;
      if (form) {
        form.addEventListener('submit', () => {
          const publishedCheckbox = document.getElementById('published') as HTMLInputElement;
          const existingHidden = form.querySelector('input[name="published"][type="hidden"]');
          if (existingHidden) existingHidden.remove();
          if (!publishedCheckbox?.checked) {
            const hiddenField = document.createElement('input');
            hiddenField.type = 'hidden';
            hiddenField.name = 'published';
            hiddenField.value = 'false';
            form.appendChild(hiddenField);
          }
        });
      }
    });
  </script>
</BaseLayout>
